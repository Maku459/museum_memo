# OCRの実行ファイルと言語データの取得元。
# 既定（未設定）ではtesseract.jsのCDNから自動で取得するので、通常は設定不要です。
# 外部への接続が制限された環境で使う場合のみ、
#   npm run vendor:tesseract
# を実行してファイルを配置したうえで、このファイルを .env にコピーして有効にしてください。

# VITE_TESS_WORKER_PATH=./tesseract/worker.min.js
# VITE_TESS_CORE_PATH=./tesseract
# VITE_TESSDATA_PATH=./tessdata

# traineddata を .gz ではなく展開した状態で置く場合は false にします。
# VITE_TESSDATA_GZIP=true
